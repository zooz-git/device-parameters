{
    "description": "ZEN05 Outdoor Plug",
    "parameters": [
        {
            "parameterNumber": 1,
            "label": {
                "en": "LED Indicator Behavior",
                "pl": ""
            },
            "description": {
                "en": "Decide how the LED indicator behaves depending on the on/off status of the plug.",
                "pl": ""
            },
            "size": 1,
            "defaultValue": 0,
            "format": {
                "type": "enumerated",
                "values": [
                    {
                        "type": "value",
                        "value": 0,
                        "description": {
                            "en": "LED on when plug on, LED off when plug off",
                            "pl": ""
                        }
                    },
                    {
                        "type": "value",
                        "value": 1,
                        "description": {
                            "en": "LED on when plug off, LED off when plug on",
                            "pl": ""
                        }
                    },
                    {
                        "type": "value",
                        "value": 2,
                        "description": {
                            "en": "LED always off",
                            "pl": ""
                        }
                    },
                    {
                        "type": "value",
                        "value": 3,
                        "description": {
                            "en": "LED always on",
                            "pl": ""
                        }
                    }
                ]
            }
        },
        {
            "parameterNumber": 2,
            "label": {
                "en": "Auto-off Timer",
                "pl": ""
            },
            "description": {
                "en": "Auto-off timer will automatically turn the Smart Plug off after x minutes once it has been turned on.",
                "pl": ""
            },
            "size": 4,
            "defaultValue": 0,
            "format": {
                "type": "enumerated",
                "values": [
                    {
                        "type": "value",
                        "value": 0,
                        "description": {
                            "en": "timer disabled",
                            "pl": ""
                        }
                    },
                    {
                        "type": "range",
                        "min": 1,
                        "max": 65535,
                        "step": 1,
                        "scale": 1,
                        "unit": "min"
                    }
                ]
            }
        },
        {
            "parameterNumber": 4,
            "label": {
                "en": "Auto-on Timer",
                "pl": ""
            },
            "description": {
